<launch>

    <node pkg="zed_cpu" type="zed_node" name="zed_node" output="screen"/>
    <node pkg="zed_cpu" type="zed2i_rectification_node_new.py" name="image_rect_node" output="log"/>
    <node pkg="waterlinked_a50_ros_driver" type="publisher.py" name="publisher">
        <param name="ip" value="192.168.2.95"/>
        <param name="port" value="16171"/>
    </node>
</launch>
